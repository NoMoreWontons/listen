# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Supabase: Project settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key   # service_role, stays server-side only

# Anthropic: console.anthropic.com → API keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional (defaults shown)
WHISPER_MODEL=large-v3-turbo   # tiny for a fast first run
RETENTION_DAYS=7
# Comments go on their own line above a blank value: dotenv reads
# "KEY=   # note" as the value "# note", not as empty.
# blank = ~/College Lectures
OBSIDIAN_VAULT=
# blank = auto from date; e.g. Bridge to force a label
SEMESTER_OVERRIDE=
MODEL_LOAD_STALL_S=300        # abort model load if progress stalls this long
